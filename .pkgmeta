# How the release zip is built (BigWigs packager). The addon lives in the
# jsalUI folder, so it's moved up to be the zip's only folder; the data and
# tools used to regenerate its tables stay out.
package-as: jsalUI

# The release notes are written by hand in CHANGELOG.md, for players, rather
# than built from the commit messages. Each release replaces them.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

move-folders:
  jsalUI/jsalUI: jsalUI

ignore:
  - data
  - tools
  - notes
  - README.md
